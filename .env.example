PORT=3000
NODE_ENV=development

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=60

# Temporal configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-aggregation

# Mock supplier endpoints (defaults to local Express mock endpoints)
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels

# Supplier failure simulation flags (true / false)
SUPPLIER_A_FAIL=false
SUPPLIER_B_FAIL=false
